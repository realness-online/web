#!/usr/bin/env python3
"""brayness publish [dir] - serve a built site from this actor.

Asks the host through the door (guest-initiated vsock to CID 2, port 54). The
host copies the directory out and serves it at /s/<actor>/; this prints the
link. The directory defaults to /brayness/site and should hold built HTML.
"""
import json
import os
import socket
import sys

HOST_CID = 2
DOOR_PORT = 54

path = os.path.abspath(sys.argv[1] if len(sys.argv) > 1 else "/brayness/site")
if not os.path.isfile(os.path.join(path, "index.html")):
    sys.exit(f"brayness publish: {path} has no index.html; build the site first")

sock = socket.socket(socket.AF_VSOCK, socket.SOCK_STREAM)
sock.settimeout(120)
try:
    sock.connect((HOST_CID, DOOR_PORT))
except OSError as error:
    sys.exit(f"brayness publish: the host did not answer ({error})")
with sock:
    sock.sendall(json.dumps({"op": "publish", "path": path}).encode() + b"\n")
    buf = b""
    while b"\n" not in buf:
        chunk = sock.recv(4096)
        if not chunk:
            break
        buf += chunk
reply = json.loads(buf.partition(b"\n")[0] or b"{}")
if not reply.get("ok"):
    sys.exit(f"brayness publish: {reply.get('error', 'no reply from the host')}")
print(f"published {path}")
print(reply["url"])
