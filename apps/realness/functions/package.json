{
  "name": "realness-functions",
  "description": "Realness server side: scheduled web-push notifications",
  "private": true,
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "serve": "firebase emulators:start --only functions --config ../firebase.functions.json",
    "shell": "firebase functions:shell --config ../firebase.functions.json",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions --config ../firebase.functions.json",
    "logs": "firebase functions:log --config ../firebase.functions.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@realness.online/thoughts": "1.0.0",
    "dotenv": "16.6.1",
    "firebase-admin": "13.1.0",
    "firebase-functions": "6.3.2",
    "happy-dom": "20.14.3",
    "twilio": "5.13.1",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.4",
    "globals": "15.15.0",
    "prettier": "3.8.5",
    "vitest": "4.1.10"
  },
  "imports": {
    "#handlers/*": "./src/handlers/*",
    "#services/*": "./src/services/*",
    "#utils/*": "./src/utils/*"
  }
}
