# Local emulator only. In production, set Firebase Functions secrets:
#   firebase functions:secrets:set TWILIO_ACCOUNT_SID
#   firebase functions:secrets:set TWILIO_AUTH_TOKEN
#
# For the emulator, copy to .env or .env.local and fill in values.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Push (same pattern as Twilio):
#   firebase functions:secrets:set VAPID_PRIVATE_KEY
VAPID_PRIVATE_KEY=replace_me

# Prints (same pattern):
#   firebase functions:secrets:set STRIPE_SECRET_KEY
#   firebase functions:secrets:set STRIPE_WEBHOOK_SECRET
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The one author whose posters are for sale, e.g. /+16282281824
PRINTS_AUTHOR=/+16282281824
