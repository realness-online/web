{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "strict": false,
    "strictNullChecks": true,
    "allowJs": true,
    "checkJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "lib": ["esnext", "dom"],
    "paths": {
      "/scripts/watch-for-updates.js": ["./src/app/use/watch-for-updates.js"]
    }
  },
  "include": [
    "src/**/*.js",
    "lib/**/*.js",
    "server/**/*.js",
    "tools/**/*.js",
    "tools/**/*.d.ts",
    "themes/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "src/app",
    "src/chat",
    "src/terminal",
    "src/sign-on/browser",
    "**/dist/**",
    "**/specs/**",
    "checks/**",
    "**/test/**"
  ]
}
