  "ignoreDependencies": [
    "stylus",
    "vue-eslint-parser",
    "eslint-plugin-compat",
    "@lhci/cli",
    "@earendil-works/pi-ai",
    "@earendil-works/pi-coding-agent",
    "@realness.online/itemid",
    "@realness.online/store",
