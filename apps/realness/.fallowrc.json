      "exports": ["up", "down", "restart"]
    },
    {
      "file": "src/control/halo-lima.js",
      "exports": ["up", "down", "restart"]
    }
  ],
  "regression": {
    "baseline": {
      "analysisIdentity": {
        "mode": "syntactic",
        "semantic_schema_version": 1,
        "capabilities": [],
        "project_config_hash": "",
        "backend_family": "",
        "completeness": "complete"
      },
      "totalIssues": 32,
      "unusedFiles": 0,
      "unusedExports": 0,
      "unusedTypes": 0,
      "unusedDependencies": 0,
      "unusedDevDependencies": 0,
      "unusedOptionalDependencies": 0,
      "unusedEnumMembers": 0,
      "unusedClassMembers": 19,
      "unresolvedImports": 0,
      "unlistedDependencies": 0,
      "duplicateExports": 10,
      "circularDependencies": 0,
      "reExportCycles": 0,
      "typeOnlyDependencies": 0,
      "testOnlyDependencies": 0,
      "devDependenciesInProduction": 3,
      "boundaryViolations": 0,
