{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "index.html",
    "src/app/workers/*.js",
    "scripts/*.js",
    "tools/publish/renderer/static/**",
    "**/*.check.js",
    "specs/**/*.spec.js",
    "src/settings/cli.js",
    "server/halo/app.js",
    "server/halo/main.js",
    "server/halo/clients/login.js",
    "server/*/scripts/*.js",
    "tools/control/scripts/*.js",
    "tools/control/bin/capacity-sample.js",
    "tools/desktop/entry.ts",
    "tools/publish/renderer/serve.js",
    "server/halo/guest/*.js",
    "tools/control/escape-probe/server.js",
    "themes/load.js",
    "themes/adapters/*.js",
    "themes/*/palette.css",
    "vite.config.js",
    "vite.prerender.config.js",
    "workers.config.js",
    "public/push-handlers.js",
    "src/app/prerender/entry-server.js",
    "server/sync/bin/realness.js",
    "server/*/bin/*.js",
    "tools/cli/bin/*.js",
    "packages/*/src/index.js",
    "packages/store/src/firebase.js",
    "packages/store/src/local-only.js",
    "durable.config.js",
    "src/app/utils/durable-entry.js"
  ],
  "ignorePatterns": [
    "**/artifacts/**",
    "**/dist/**",
    "**/coverage/**",
    "src/app/wasm/**",
    "**/public/wasm/**",
    "public/*.worker.js",
    "**/docs/generated/**"
  ],
  "ignoreDependencies": [
    "stylus",
    "vue-eslint-parser",
    "eslint-plugin-compat",
    "@lhci/cli",
    "@earendil-works/pi-ai",
    "@earendil-works/pi-coding-agent",
    "@realness.online/itemid",
    "@realness.online/store",
    "@realness.online/thoughts",
    "template-for-polyfill",
    "pele",
    "@earendil-works/chord",
    "@earendil-works/pi-durable",
    "pi-durable-storage-idb",
    "pi-durable-storage-html"
  ],
  "ignoreUnresolvedImports": [
    "/pi-durable.browser.js",
    "/scripts/template-for-polyfill.js",
    "/scripts/register.js",
    "/scripts/watch-for-updates.js",
    "**/targets.json",
    "**/pi-ai/dist/utils/retry.js"
  ],
  "rules": {
    "unused-files": "warn",
    "unused-exports": "warn",
    "unused-types": "off",
    "private-type-leaks": "off",
    "unused-class-members": "warn",
    "duplicate-exports": "warn",
    "circular-dependencies": "error",
    "unresolved-imports": "warn"
  },
  "overrides": [
    {
      "files": [
        "**/specs/**",
        "**/test/**",
        "**/*.spec.js",
        "**/*.test.js"
      ],
      "rules": {
        "unused-exports": "off",
        "unused-files": "off"
      }
    },
    {
      "files": [
        "src/app/components/icon.vue",
        "src/app/components/events/as-button.vue",
        "specs/app/mocks/html/**"
      ],
      "rules": {
        "unresolved-imports": "off"
      }
    }
  ],
  "duplicates": {
    "mode": "mild",
    "minTokens": 80,
    "minLines": 8
  },
  "health": {
    "ignore": [
      "**/specs/**",
      "**/test/**",
      "**/*.spec.js",
      "**/*.test.js",
      "src/app/wasm/**"
    ],
    "maxCyclomatic": 20,
    "maxCognitive": 15
