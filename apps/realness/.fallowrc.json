{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "frontend/index.html",
    "src/app/workers/*.js",
    "frontend/scripts/*.js",
    "tools/publish/renderer/static/**",
    "**/*.check.js",
    "tests/**/*.check.js",
    "src/settings/cli.js",
    "server/host/app.js",
    "server/host/clients/login.js",
    "server/*/scripts/*.js",
    "tools/control/scripts/*.js",
    "tools/control/bin/capacity-sample.js",
    "tools/desktop/entry.ts",
    "tools/publish/renderer/serve.js",
    "server/host/guest/realness-serve.js",
    "tools/control/escape-probe/server.js",
    "themes/load.js",
    "themes/adapters/*.js",
    "themes/*/palette.css"
  ],
  "ignorePatterns": [
    "**/artifacts/**",
    "**/dist/**",
    "**/coverage/**",
    "src/app/wasm/**",
    "**/public/wasm/**",
    "**/docs/generated/**"
  ],
  "ignoreDependencies": ["stylus", "vue-eslint-parser"],
  "rules": {
    "unused-files": "warn",
    "unused-exports": "warn",
    "unused-types": "off",
    "unresolved-imports": "warn"
  },
  "overrides": [
    {
      "files": [
        "frontend/tests/**/*.js",
        "frontend/tests/**/*.spec.js",
        "**/test/**/*.js",
        "**/*.test.js",
        "**/tests/mocks/**"
      ],
      "rules": {
        "unused-exports": "off",
        "unused-files": "off"
      }
    },
    {
      "files": [
        "src/app/components/icon.vue",
        "src/app/components/events/as-button.vue",
        "frontend/tests/mocks/html/**"
      ],
      "rules": {
        "unresolved-imports": "off"
      }
    }
  ],
  "duplicates": {
    "mode": "mild",
    "minTokens": 80,
    "minLines": 8
  },
  "health": {
    "ignore": ["**/tests/**", "**/test/**", "**/*.test.js", "src/app/wasm/**"],
    "maxCyclomatic": 20,
    "maxCognitive": 15
  },
  "ignoreExports": [
    {
      "file": "src/app/use/layer.js",
      "exports": ["*"]
    },
    {
      "file": "src/app/utils/opacity.js",
      "exports": ["*"]
    },
    {
      "file": "src/app/utils/color-converters.js",
      "exports": ["*"]
    },
    {
      "file": "src/app/utils/colors.js",
      "exports": ["*"]
    },
    {
      "file": "src/app/use/directory-processor.js",
      "exports": ["*"]
    },
    {
      "file": "src/app/use/optimize.js",
      "exports": ["*"]
    },
    {
      "file": "src/app/use/path.js",
      "exports": ["*"]
    },
    {
      "file": "src/app/use/pattern.js",
      "exports": ["*"]
    },
    {
      "file": "src/app/use/people.js",
      "exports": ["*"]
    },
    {
      "file": "src/app/use/poster.js",
      "exports": ["*"]
    },
    {
      "file": "src/app/use/statements.js",
      "exports": ["*"]
    },
    {
      "file": "src/app/use/sync-folder.js",
      "exports": ["*"]
    },
    {
      "file": "src/app/use/sync.js",
      "exports": ["*"]
    },
    {
      "file": "src/app/use/vectorize.js",
      "exports": ["*"]
    }
  ]
}
