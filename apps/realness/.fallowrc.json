{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "index.html",
    "src/app/workers/*.js",
    "scripts/*.js",
    "tools/publish/renderer/static/**",
    "**/*.check.js",
    "specs/**/*.spec.js",
    "src/settings/cli.js",
    "server/halo/app.js",
    "server/halo/main.js",
    "server/halo/clients/login.js",
    "server/*/scripts/*.js",
    "tools/control/scripts/*.js",
    "tools/control/bin/capacity-sample.js",
    "tools/desktop/entry.ts",
    "tools/publish/renderer/serve.js",
    "server/halo/guest/realness-serve.js",
    "tools/control/escape-probe/server.js",
    "themes/load.js",
    "themes/adapters/*.js",
    "themes/*/palette.css",
    "vite.config.js",
    "vite.prerender.config.js",
    "workers.config.js",
    "public/push-handlers.js",
    "src/app/prerender/entry-server.js",
    "server/sync/bin/realness.js",
    "tools/cli/bin/*.js",
