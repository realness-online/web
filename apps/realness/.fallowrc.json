    "packages/store/src/firebase.js",
    "packages/store/src/local-only.js",
    "durable.config.js",
    "src/app/utils/durable-entry.js"
  ],
  "ignorePatterns": [
    "**/artifacts/**",
    "**/dist/**",
    "**/coverage/**",
    "src/app/wasm/**",
    "**/public/wasm/**",
    "public/*.worker.js",
    "**/docs/generated/**"
  ],
  "ignoreDependencies": [
    "stylus",
    "vue-eslint-parser",
    "eslint-plugin-compat",
    "@lhci/cli",
    "@earendil-works/pi-ai",
    "@earendil-works/pi-coding-agent",
    "@realness.online/itemid",
    "@realness.online/store",
    "@realness.online/thoughts",
    "template-for-polyfill",
    "pele",
    "@earendil-works/chord",
    "@earendil-works/pi-durable",
    "pi-durable-storage-idb"
  ],
  "ignoreUnresolvedImports": [
    "/pi-durable.browser.js",
    "/scripts/template-for-polyfill.js",
    "/scripts/watch-for-updates.js",
    "**/targets.json",
    "**/pi-ai/dist/utils/retry.js"
  ],
  "rules": {
    "unused-files": "warn",
    "unused-exports": "warn",
    "unused-types": "off",
    "unused-class-members": "warn",
    "duplicate-exports": "warn",
    "circular-dependencies": "error",
    "unresolved-imports": "warn"
  },
  "overrides": [
    {
      "files": ["**/specs/**", "**/test/**", "**/*.spec.js", "**/*.test.js"],
      "rules": {
        "unused-exports": "off",
        "unused-files": "off"
      }
    },
    {
      "files": [
        "src/app/components/icon.vue",
        "src/app/components/events/as-button.vue",
        "specs/app/mocks/html/**"
      ],
      "rules": {
        "unresolved-imports": "off"
      }
    }
  ],
  "duplicates": {
    "mode": "mild",
    "minTokens": 80,
    "minLines": 8
  },
  "health": {
    "ignore": [
      "**/specs/**",
      "**/test/**",
      "**/*.spec.js",
      "**/*.test.js",
      "src/app/wasm/**"
    ],
    "maxCyclomatic": 20,
    "maxCognitive": 15
  },
  "ignoreExports": [
    {
      "file": "src/app/utils/opacity.js",
      "exports": ["*"]
    },
    {
      "file": "src/app/utils/color-converters.js",
      "exports": ["*"]
    },
    {
      "file": "src/app/utils/colors.js",
      "exports": ["*"]
    },
    {
      "file": "src/app/use/path.js",
      "exports": ["*"]
    },
    {
      "file": "src/app/use/pattern.js",
      "exports": ["*"]
    },
    {
      "file": "src/app/use/people.js",
      "exports": ["*"]
    },
    {
      "file": "src/app/use/poster.js",
      "exports": ["*"]
    },
    {
      "file": "src/app/use/statements.js",
      "exports": ["*"]
    },
    {
      "file": "src/app/use/sync-folder.js",
      "exports": ["*"]
    },
    {
      "file": "src/app/use/sync.js",
      "exports": ["*"]
    },
    {
      "file": "src/app/use/vectorize.js",
      "exports": ["*"]
    },
    {
      "file": "src/halo/vsock.js",
      "exports": ["Lines"]
    },
    {
      "file": "src/halo/pty.js",
      "exports": ["make_server"]
    },
    {
