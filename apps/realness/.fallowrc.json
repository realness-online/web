{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "index.html",
    "src/app/workers/*.js",
    "tools/publish/renderer/static/**",
    "src/settings/cli.js",
    "server/halo/app.js",
    "server/halo/main.js",
    "server/halo/clients/login.js",
    "server/*/scripts/*.js",
    "tools/control/scripts/*.js",
    "tools/control/bin/capacity-sample.js",
    "tools/desktop/entry.ts",
    "tools/publish/renderer/serve.js",
    "server/halo/guest/*.js",
    "tools/control/escape-probe/server.js",
    "themes/load.js",
    "themes/adapters/*.js",
    "themes/*/palette.css",
    "public/push-handlers.js",
    "src/app/prerender/entry-server.js",
    "server/sync/bin/realness.js",
    "server/*/bin/*.js",
    "tools/cli/bin/*.js",
    "packages/*/src/index.js",
    "packages/store/src/firebase.js",
    "packages/store/src/local-only.js",
    "src/app/utils/durable-entry.js"
  ],
  "framework": [
    {
      "name": "realness-tests",
      "enablers": ["vite-plus"],
      "entryPoints": ["**/*.check.js", "specs/**/*.spec.js"],
      "entryPointRole": "test"
    },
    {
      "name": "realness-build",
      "enablers": ["vite-plus"],
      "entryPoints": [
        "scripts/*.js",
        "vite.config.js",
        "vite.prerender.config.js",
        "workers.config.js",
        "durable.config.js"
      ],
      "entryPointRole": "support"
    }
  ],
  "ignorePatterns": [
    "**/artifacts/**",
    "**/dist/**",
    "**/coverage/**",
    "src/app/wasm/**",
    "**/public/wasm/**",
    "public/*.worker.js",
    "**/docs/generated/**"
  ],
  "ignoreDependencies": [
    "@img/sharp-darwin-arm64",
    "@img/sharp-libvips-darwin-arm64",
    "@img/sharp-libvips-linux-arm64",
    "@img/sharp-linux-arm64",
    "stylus",
    "vue-eslint-parser",
    "eslint-plugin-compat",
    "@lhci/cli",
    "@earendil-works/pi-ai",
    "@earendil-works/pi-coding-agent",
    "@realness.online/itemid",
    "@realness.online/store",
    "@realness.online/thoughts",
    "template-for-polyfill",
    "pele",
    "@earendil-works/chord",
    "@earendil-works/pi-durable",
    "pi-durable-storage-idb",
    "pi-durable-storage-html"
  ],
  "ignoreUnresolvedImports": [
    "/pi-durable.browser.js",
    "/scripts/template-for-polyfill.js",
    "/scripts/register.js",
    "/scripts/watch-for-updates.js",
    "**/targets.json",
    "**/pi-ai/dist/utils/retry.js"
  ],
  "rules": {
    "unused-files": "warn",
    "unused-exports": "warn",
    "unused-types": "off",
    "private-type-leaks": "warn",
    "unused-class-members": "warn",
    "duplicate-exports": "warn",
    "circular-dependencies": "error",
    "unresolved-imports": "warn"
  },
  "overrides": [
    {
      "files": ["**/specs/**", "**/test/**", "**/*.spec.js", "**/*.test.js"],
      "rules": {
        "unused-exports": "off",
        "unused-files": "off"
      }
    },
    {
      "files": [
        "src/app/components/icon.vue",
        "src/app/components/events/as-button.vue",
        "specs/app/mocks/html/**"
      ],
      "rules": {
        "unresolved-imports": "off"
      }
    }
  ],
  "duplicates": {
    "mode": "mild",
    "minTokens": 80,
    "minLines": 8
  },
  "health": {
    "ignore": [
      "**/specs/**",
      "**/test/**",
      "**/*.spec.js",
      "**/*.test.js",
      "src/app/wasm/**"
    ],
    "maxCyclomatic": 20,
    "maxCognitive": 15
  },
  "ignoreExports": [
    {
      "file": "src/app/utils/opacity.js",
      "exports": ["*"]
    },
    {
      "file": "src/app/utils/color-converters.js",
      "exports": ["*"]
    },
    {
      "file": "src/app/utils/colors.js",
      "exports": ["*"]
    },
    {
      "file": "src/app/use/path.js",
      "exports": ["*"]
    },
    {
      "file": "src/app/use/pattern.js",
      "exports": ["*"]
    },
    {
      "file": "src/app/use/people.js",
      "exports": ["*"]
    },
    {
      "file": "src/app/use/poster.js",
      "exports": ["*"]
    },
    {
      "file": "src/app/use/statements.js",
      "exports": ["*"]
    },
    {
      "file": "src/app/use/sync-folder.js",
      "exports": ["*"]
    },
    {
      "file": "src/app/use/sync.js",
      "exports": ["*"]
    },
    {
      "file": "src/app/use/vectorize.js",
      "exports": ["*"]
    },
    {
      "file": "src/halo/vsock.js",
      "exports": ["Lines"]
    },
    {
      "file": "src/halo/pty.js",
      "exports": ["make_server"]
    },
    {
      "file": "src/control/halo-gcp.js",
      "exports": ["up", "down", "restart"]
    },
    {
      "file": "src/control/halo-lima.js",
      "exports": ["up", "down", "restart"]
    },
    {
      "file": "src/scouts/probe.js",
      "exports": ["PROBE_SITE", "PROBE_URL"]
    },
    {
      "file": "src/halo/loops.js",
      "exports": ["stop_argv"]
    },
    {
      "file": "src/scouts/halo.js",
      "exports": ["scout_goal"]
    },
    {
      "file": "src/scouts/mail.js",
      "exports": ["run_section"]
    },
    {
      "file": "src/scouts/nodes.js",
      "exports": ["plan_file"]
    },
    {
      "file": "src/scouts/runs.js",
      "exports": ["runs_page"]
    },
    {
      "file": "src/scouts/scout.js",
      "exports": ["scout_item"]
    },
    {
      "file": "src/scouts/seen.js",
      "exports": ["finds_page"]
    },
    {
      "file": "src/halo/render.js",
      "exports": ["render_page"]
    },
    {
      "file": "src/scouts/preflight.js",
      "exports": ["FREE_BYTES"]
    }
  ],
  "regression": {
    "baseline": {
      "analysisIdentity": {
        "mode": "type-aware",
        "semantic_schema_version": 2,
        "capabilities": ["symbol-use", "api-surface"],
        "project_config_hash": "sha256:8c52e0beab0e6e578072ec9b2dc5f11a9cafeb67385cffdce298af13afc44960",
        "backend_family": "typescript-go",
        "completeness": "partial"
      },
      "totalIssues": 0,
      "unusedFiles": 0,
      "unusedExports": 0,
      "unusedTypes": 0,
      "unusedDependencies": 0,
      "unusedDevDependencies": 0,
      "unusedOptionalDependencies": 0,
      "unusedEnumMembers": 0,
      "unusedClassMembers": 0,
      "unresolvedImports": 0,
      "unlistedDependencies": 0,
      "duplicateExports": 0,
      "circularDependencies": 0,
      "reExportCycles": 0,
      "typeOnlyDependencies": 0,
      "testOnlyDependencies": 0,
      "devDependenciesInProduction": 0,
      "boundaryViolations": 0,
      "boundaryCoverageViolations": 0,
      "boundaryCallViolations": 0,
      "policyViolations": 0
    }
  }
}
