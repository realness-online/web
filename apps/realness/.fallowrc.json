    "/scripts/template-for-polyfill.js",
    "/scripts/watch-for-updates.js",
    "**/targets.json"
  ],
  "rules": {
    "unused-files": "warn",
    "unused-exports": "warn",
    "unused-types": "off",
    "unused-class-members": "warn",
    "duplicate-exports": "warn",
    "circular-dependencies": "error",
    "unresolved-imports": "warn"
  },
  "overrides": [
    {
      "files": ["**/tests/**", "**/test/**", "**/*.spec.js", "**/*.test.js"],
      "rules": {
        "unused-exports": "off",
        "unused-files": "off"
      }
    },
    {
      "files": [
        "src/app/components/icon.vue",
        "src/app/components/events/as-button.vue",
        "frontend/tests/mocks/html/**"
      ],
      "rules": {
        "unresolved-imports": "off"
      }
    }
  ],
  "duplicates": {
    "mode": "mild",
    "minTokens": 80,
    "minLines": 8
  },
  "health": {
    "ignore": ["**/tests/**", "**/test/**", "**/*.test.js", "src/app/wasm/**"],
    "maxCyclomatic": 20,
    "maxCognitive": 15
