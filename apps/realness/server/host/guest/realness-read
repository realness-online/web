#!/usr/bin/env python3
"""realness-read <url> [--fresh] - read a public page through the host's internet engine.

Asks the host through the door (guest-initiated vsock to CID 2, port 54). The
host reads the page from its shared cache, a static fetch, a Chrome VM, or
Firecrawl, and replies with JSON on stdout: source, kind (html or markdown),
body, title. web-md calls this in an actor and turns the body into markdown.
"""
import json
import socket
import sys

args = [a for a in sys.argv[1:] if a != "--fresh"]
if len(args) != 1:
    sys.exit("usage: realness-read <url> [--fresh]")

sock = socket.socket(socket.AF_VSOCK, socket.SOCK_STREAM)
sock.settimeout(180)
try:
    sock.connect((2, 54))
except OSError as error:
    sys.exit(f"realness-read: the host did not answer ({error})")
with sock:
    sock.sendall(json.dumps({"op": "read", "url": args[0], "fresh": "--fresh" in sys.argv}).encode() + b"\n")
    buf = b""
    while b"\n" not in buf:
        chunk = sock.recv(1 << 20)
        if not chunk:
            break
        buf += chunk
reply = json.loads(buf.partition(b"\n")[0] or b"{}")
if not reply.get("ok"):
    sys.exit(f"realness-read: {reply.get('error', 'no reply from the host')}")
json.dump(reply, sys.stdout)
