#!/usr/bin/env python3
"""brayness loop - hand long work to a loop in its own actor.

    brayness loop "<goal>"        start a loop; prints its id
    brayness loop report <id>     its status, runs, stop reason, log tail

Asks the host through the door (guest-initiated vsock to CID 2, port 54).
The host bounds depth, fan-out, runs, and time; see plans/brayness.md, a1.
"""
import json
import socket
import sys

HOST_CID = 2
DOOR_PORT = 54


def door(request, timeout):
    sock = socket.socket(socket.AF_VSOCK, socket.SOCK_STREAM)
    sock.settimeout(timeout)
    try:
        sock.connect((HOST_CID, DOOR_PORT))
    except OSError as error:
        sys.exit(f"brayness loop: the host did not answer ({error})")
    with sock:
        sock.sendall(json.dumps(request).encode() + b"\n")
        buf = b""
        while b"\n" not in buf:
            chunk = sock.recv(65536)
            if not chunk:
                break
            buf += chunk
    reply = json.loads(buf.partition(b"\n")[0] or b"{}")
    if not reply.get("ok"):
        sys.exit(f"brayness loop: {reply.get('error', 'no reply from the host')}")
    return reply


args = sys.argv[1:]
if len(args) == 2 and args[0] == "report":
    print(json.dumps(door({"op": "loop-report", "id": args[1]}, 30)["loop"], indent=2))
elif len(args) == 1 and args[0] not in ("-h", "--help", "report"):
    reply = door({"op": "loop", "goal": args[0]}, 300)  # starting an actor takes a while
    print(f"loop {reply['id']} started")
    print(f"brayness loop report {reply['id']}")
else:
    sys.exit(__doc__.strip().split("\n\n")[1])
