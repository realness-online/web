#!/usr/bin/env python3
"""Print a fresh person-bound model pass from the host door.

Pi's models.json runs this per request (`!brayness-model-pass`). The host
verifies this VM, names its owner, and signs a sixty-second pass. Nothing is
stored on disk, so seeds and exports carry no model credential.
"""
import json
import socket
import sys

HOST_CID = 2
DOOR_PORT = 54


def door_pass():
    sock = socket.socket(socket.AF_VSOCK, socket.SOCK_STREAM)
    sock.settimeout(10)
    with sock:
        sock.connect((HOST_CID, DOOR_PORT))
        sock.sendall(b'{"op":"model-pass"}\n')
        response = b""
        while b"\n" not in response:
            chunk = sock.recv(4096)
            if not chunk:
                break
            response += chunk
    answer = json.loads(response.partition(b"\n")[0] or b"{}")
    if not answer.get("ok"):
        raise RuntimeError(answer.get("error", "host door did not issue a model pass"))
    return answer["pass"]


if __name__ == "__main__":
    try:
        print(door_pass())
    except (OSError, ValueError, RuntimeError, AttributeError) as error:
        print(f"brayness-model-pass: {error}", file=sys.stderr)
        sys.exit(1)
