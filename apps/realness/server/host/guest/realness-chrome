#!/usr/bin/env python3
"""realness chrome [return] - lease a fresh Chrome from the host, or give it back.

Asks the host through the door (guest-initiated vsock to CID 2, port 54). A
lease prints the copy's DevTools address; connect agent-browser to it:

    agent-browser connect "$(realness chrome)"

The copy can open this actor's own dev server (http://<this actor's address>:<port>).
It lasts 30 minutes, or until `realness chrome return`; a returned copy is destroyed.
"""
import json
import socket
import sys

HOST_CID = 2
DOOR_PORT = 54

op = "chrome-return" if sys.argv[1:2] == ["return"] else "chrome-lease"
if sys.argv[1:2] not in ([], ["return"], ["lease"]):
    sys.exit("usage: realness chrome [lease|return]")

sock = socket.socket(socket.AF_VSOCK, socket.SOCK_STREAM)
# The host's first lease boots Chrome once (about 20 s); later ones restore in seconds.
sock.settimeout(180)
try:
    sock.connect((HOST_CID, DOOR_PORT))
except OSError as error:
    sys.exit(f"realness chrome: the host did not answer ({error})")
with sock:
    sock.sendall(json.dumps({"op": op}).encode() + b"\n")
    buf = b""
    while b"\n" not in buf:
        chunk = sock.recv(4096)
        if not chunk:
            break
        buf += chunk
reply = json.loads(buf.partition(b"\n")[0] or b"{}")
if not reply.get("ok"):
    sys.exit(f"realness chrome: {reply.get('error', 'no reply from the host')}")
if op == "chrome-return":
    print("returned" if reply.get("returned") else "no chrome was leased")
else:
    print(reply["devtools"])
    print(f"until {reply['expires']}", file=sys.stderr)
