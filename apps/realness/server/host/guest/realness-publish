#!/usr/bin/env python3
"""realness publish [dir] - serve a built site from this actor.

Asks the host through the door (guest-initiated vsock to CID 2, port 54). The
host copies the directory out and serves it at /s/<actor>/; this prints the
link. The directory defaults to /realness/site and should hold built HTML.
"""
import json
import os
import socket
import sys
import re

HOST_CID = 2
DOOR_PORT = 54
SITE_ROOT = "/realness/work/site"
SITE_ID = os.path.join(SITE_ROOT, ".realness-site-id")

path = os.path.abspath(sys.argv[1] if len(sys.argv) > 1 else "/realness/site")
if not os.path.isfile(os.path.join(path, "index.html")):
    sys.exit(f"realness publish: {path} has no index.html; build the site first")

sock = socket.socket(socket.AF_VSOCK, socket.SOCK_STREAM)
sock.settimeout(120)
try:
    sock.connect((HOST_CID, DOOR_PORT))
except OSError as error:
    sys.exit(f"realness publish: the host did not answer ({error})")
with sock:
    request = {"op": "publish", "path": path}
    if path == SITE_ROOT or path.startswith(SITE_ROOT + "/"):
        if os.path.isfile(SITE_ID):
            site = open(SITE_ID, encoding="utf-8").read().strip()
            if not re.fullmatch(r"a-[a-f0-9]{12}", site):
                sys.exit("realness publish: invalid saved site ID")
            request["site"] = site
    sock.sendall(json.dumps(request).encode() + b"\n")
    buf = b""
    while b"\n" not in buf:
        chunk = sock.recv(4096)
        if not chunk:
            break
        buf += chunk
reply = json.loads(buf.partition(b"\n")[0] or b"{}")
if not reply.get("ok"):
    sys.exit(f"realness publish: {reply.get('error', 'no reply from the host')}")
if (path == SITE_ROOT or path.startswith(SITE_ROOT + "/")) and reply.get("site"):
    with open(SITE_ID, "w", encoding="utf-8") as marker:
        marker.write(reply["site"] + "\n")
print(f"published {path}")
print(reply["url"])
