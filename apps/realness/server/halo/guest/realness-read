#!/usr/bin/env python3
"""realness-read <url> [--fresh] - read a public page through the halo's internet engine.

Asks the halo through the door (guest-initiated vsock to CID 2, port 54). The
halo reads the page from its shared cache, a static fetch, a Chrome VM, or
Firecrawl, and replies with JSON on stdout: source, kind (html or markdown),
body, title. web-md calls this in an actor and turns the body into markdown.
"""
import json
import os
import socket
import sys

DOOR_SOCKET = "/run/realness/door.sock"


def door_socket():
    """The halo door: vsock on Firecracker, a unix socket inside a box."""
    family = socket.AF_UNIX if os.path.exists(DOOR_SOCKET) else socket.AF_VSOCK
    return socket.socket(family, socket.SOCK_STREAM)


def door_address(sock):
    return DOOR_SOCKET if sock.family == socket.AF_UNIX else (2, 54)


args = [a for a in sys.argv[1:] if a != "--fresh"]
if len(args) != 1:
    sys.exit("usage: realness-read <url> [--fresh]")

sock = door_socket()
sock.settimeout(180)
try:
    sock.connect(door_address(sock))
except OSError as error:
    sys.exit(f"realness-read: the halo did not answer ({error})")
with sock:
    sock.sendall(json.dumps({"op": "read", "url": args[0], "fresh": "--fresh" in sys.argv}).encode() + b"\n")
    buf = b""
    while b"\n" not in buf:
        chunk = sock.recv(1 << 20)
        if not chunk:
            break
        buf += chunk
reply = json.loads(buf.partition(b"\n")[0] or b"{}")
if not reply.get("ok"):
    sys.exit(f"realness-read: {reply.get('error', 'no reply from the halo')}")
json.dump(reply, sys.stdout)
