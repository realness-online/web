#!/usr/bin/env python3
"""realness loop - hand long work to a loop in its own actor.

    realness loop "<goal>"        start a loop; prints its id
    realness loop report <id>     its status, runs, stop reason, log tail

Asks the halo through the door (guest-initiated vsock to CID 2, port 54).
The halo bounds depth, fan-out, runs, and time; see vault/Projects/realness.md.
"""
import json
import os
import socket
import sys

DOOR_SOCKET = "/run/realness/door.sock"


def door_socket():
    """The halo door: vsock on Firecracker, a unix socket inside a box."""
    family = socket.AF_UNIX if os.path.exists(DOOR_SOCKET) else socket.AF_VSOCK
    return socket.socket(family, socket.SOCK_STREAM)


def door_address(sock):
    return DOOR_SOCKET if sock.family == socket.AF_UNIX else (2, 54)


def door(request, timeout):
    sock = door_socket()
    sock.settimeout(timeout)
    try:
        sock.connect(door_address(sock))
    except OSError as error:
        sys.exit(f"realness loop: the halo did not answer ({error})")
    with sock:
        sock.sendall(json.dumps(request).encode() + b"\n")
        buf = b""
        while b"\n" not in buf:
            chunk = sock.recv(65536)
            if not chunk:
                break
            buf += chunk
    reply = json.loads(buf.partition(b"\n")[0] or b"{}")
    if not reply.get("ok"):
        sys.exit(f"realness loop: {reply.get('error', 'no reply from the halo')}")
    return reply


args = sys.argv[1:]
if len(args) == 2 and args[0] == "report":
    print(json.dumps(door({"op": "loop-report", "id": args[1]}, 30)["loop"], indent=2))
elif len(args) == 1 and args[0] not in ("-h", "--help", "report"):
    reply = door({"op": "loop", "goal": args[0]}, 300)  # starting an actor takes a while
    print(f"loop {reply['id']} started")
    print(f"realness loop report {reply['id']}")
else:
    sys.exit(__doc__.strip().split("\n\n")[1])
