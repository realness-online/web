#!/usr/bin/env python3
"""Print a fresh person-bound model pass from the halo door.

Pi's models.json runs this per request (`!realness-model-pass`). The halo
verifies this VM, names its owner, and signs a sixty-second pass. Nothing is
stored on disk, so seeds and exports carry no model credential.
"""
import json
import os
import socket
import sys

DOOR_SOCKET = "/run/realness/door.sock"


def door_socket():
    """The halo door: vsock on Firecracker, a unix socket inside a box."""
    family = socket.AF_UNIX if os.path.exists(DOOR_SOCKET) else socket.AF_VSOCK
    return socket.socket(family, socket.SOCK_STREAM)


def door_address(sock):
    return DOOR_SOCKET if sock.family == socket.AF_UNIX else (2, 54)


def door_pass():
    sock = door_socket()
    sock.settimeout(10)
    with sock:
        sock.connect(door_address(sock))
        sock.sendall(b'{"op":"model-pass"}\n')
        response = b""
        while b"\n" not in response:
            chunk = sock.recv(4096)
            if not chunk:
                break
            response += chunk
    answer = json.loads(response.partition(b"\n")[0] or b"{}")
    if not answer.get("ok"):
        raise RuntimeError(answer.get("error", "halo door did not issue a model pass"))
    return answer["pass"]


if __name__ == "__main__":
    try:
        print(door_pass())
    except (OSError, ValueError, RuntimeError, AttributeError) as error:
        print(f"realness-model-pass: {error}", file=sys.stderr)
        sys.exit(1)
