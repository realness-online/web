{
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": [
    {
      "target": "app",
      "public": "../../../artifacts/brayness/frontend/dist",
      "trailingSlash": false,
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "**/Thumbs.db",
        "**/desktop.ini",
        "**/__MACOSX/**"
      ],
      "redirects": [
        {
          "source": "/privacy",
          "destination": "/terms#privacy-policy",
          "type": 301
        }
      ],
      "rewrites": [
        {
          "source": "/capabilities",
          "function": "capabilities"
        },
        {
          "source": "/check-phone-integrity",
          "function": "check_phone_integrity"
        },
        {
          "regex": "/prints/[0-9]+",
          "function": "print_share"
        },
        {
          "source": "/prints-checkout",
          "function": "prints_checkout"
        },
        {
          "source": "/prints-list",
          "function": "prints_list"
        },
        {
          "source": "/prints-webhook",
          "function": "prints_webhook"
        },
        {
          "source": "/v1/**",
          "run": {
            "serviceId": "brayness-sync",
            "region": "us-central1"
          }
        },
        {
          "source": "/pay/**",
          "run": {
            "serviceId": "brayness-proxy",
            "region": "us-central1"
          }
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Content-Security-Policy",
              "value": "script-src 'unsafe-eval' 'unsafe-inline' 'self' https://www.google.com https://apis.google.com https://www.gstatic.com https://storage.googleapis.com/ https://js.stripe.com"
            }
          ]
        },
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "**/*.@(png|jpg|jpeg|gif|webp|ico|woff2|svg|mp4)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400"
            }
          ]
        },
        {
          "source": "/fonts/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/icons.svg",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400"
            }
          ]
        },
        {
          "source": "/service.worker.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    },
    {
      "target": "sites",
      "public": "sites",
      "trailingSlash": true,
      "rewrites": [
        {
          "source": "/sites/**",
          "run": {
            "serviceId": "brayness-sync",
            "region": "us-central1"
          }
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            }
          ]
        }
      ]
    }
  ]
}
