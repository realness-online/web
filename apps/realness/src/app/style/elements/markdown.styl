section[itemprop='content'],
[itemtype$='/Message'] > section[itemprop='text'],
section[itemprop='articleBody'] {
  min-width: 0;
  max-width: 100%;
  user-select: text;
  -webkit-user-select: text;
  -webkit-touch-callout: default;
  touch-action: auto;

  & * {
    user-select: text;
    -webkit-user-select: text;
    -webkit-touch-callout: default;
    touch-action: auto;
  }

  h1, h2, h3, h4, h5, h6 {
    color: var(--emphasis);
    margin-top: base-line * 2;
    scroll-margin-top: s('calc(env(safe-area-inset-top, 0px) + %s * 2)', base-line);

    &:first-child {
      margin-top: 0;
    }
  }

  h1 {
    color: var(--accent);

    & > span {
      color: var(--accent);
      font-size: 0.66em;
      font-weight: 300;
    }
  }

  p, li {
    line-height: 1.6;
    overflow-wrap: break-word;
  }

  ul, ol {
    margin-bottom: base-line;
    margin-left: 0;
    padding-inline-start: 0;
    max-width: page-width;
  }

  ul {
    list-style: disc;
    list-style-position: outside;
  }

  ol {
    list-style: decimal;
    list-style-position: outside;
  }

  ul, ol {
    li {
      margin-bottom: base-line;

      &:last-child {
        margin-bottom: 0;
      }

      & > svg.inline-icon {
        display: inline-block;
        width: base-line * 0.75;
        height: base-line * 0.75;
        margin-right: round((base-line / 4), 2);
        vertical-align: -0.12em;
        fill: currentColor;
        overflow: visible;
        pointer-events: none;
        stroke-width: 0;

        &.animation {
          stroke: currentColor;
          stroke-width: 2;
          paint-order: stroke fill;
          stroke-linejoin: round;
          stroke-linecap: round;
        }
      }
    }
  }

  code {
    background: var(--code-surface);
    padding: 0 round((base-line / 6), 2);
    border-radius: round((base-line / 4), 2);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    overflow-wrap: anywhere;
    font-family: 'Monaco', 'Menlo', monospace;
    font-size: 0.875rem;
  }

  pre {
    background: var(--code-surface);
    padding: base-line;
    border-radius: round((base-line / 4), 2);
    overflow-x: auto;
    margin-bottom: base-line;

    code {
      background: none;
      padding: 0;
    }
  }

  blockquote {
    border-left: 3px solid var(--emphasis);
    padding-left: base-line;
    margin-bottom: base-line;
    font-style: italic;
  }

  a {
    color: var(--accent);
    text-decoration: none;

    &:hover {
      color: var(--emphasis);
    }
  }
}

section[itemprop='articleBody'] pre {
  white-space: pre-wrap;
  overflow-wrap: anywhere;

  span {
    color: var(--shiki-light);
  }
}

strong,
b {
  font-weight: 800;
  color: var(--emphasis);
}

section[itemprop='articleBody'] > details:not(:has(figure)) {
  > summary {
    display: flex;
    gap: var(--base-line);
    align-items: baseline;
    cursor: pointer;

    &::before {
      content: '▸';
      transition: rotate 0.15s;
    }

    & span {
      margin-inline-start: auto;
      opacity: 0.6;
    }

    & time {
      opacity: 0.6;
    }
  }

  &[open] > summary::before {
    rotate: 90deg;
  }

  & h4 {
    display: flex;
    gap: var(--base-line);
    align-items: baseline;

    & span {
      opacity: 0.6;
    }
  }

  & table {
    inline-size: 100%;
    margin-inline: 0;
  }

  & tr {
    display: grid;
    grid-template-columns: 2ch 1fr;
    column-gap: var(--base-line);
    border-block-end: 1px solid var(--rule);
  }

  & thead {
    display: none;
  }

  & th,
  & td {
    border: 0;
    padding-block-start: calc(var(--base-line) * 0.25);
    padding-block-end: calc(var(--base-line) * 0.5);
    font-size: 0.875em;
    line-height: 1.6;
  }

  & tr > :last-child {
    grid-column: 2;
  }

  & td:first-child {
    font-variant-numeric: tabular-nums;
    text-align: end;
  }

  & tbody + tbody {
    opacity: 0.5;
  }
}

@media (prefers-color-scheme: dark) {
  section[itemprop='articleBody'] pre span {
    color: var(--shiki-dark);
  }
}
