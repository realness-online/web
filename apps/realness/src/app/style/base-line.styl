
@require 'mixins'

base-line = 1.333rem

min-modular = 1.250
max-modular = 1.414

min-font = 1.125rem
max-font = 1.33rem

pad-begins = round(base-line * 26)
typing-begins = round(base-line * 48)
display-begins = round(base-line * 60)

page-width = round(base-line * 22)

page-width-large = round(base-line * 32)

page-width-max = round(base-line * 48)

page-width-4k = round(base-line * 92, 0)
poster-wide-min = round(base-line * 24, 0)

support-page-width = round(base-line * 52)

poster-min-width = round(base-line * 10, 0)

poster-grid-height = round(base-line * 22, 0)

poster-thoughts-height = round((page-width), 2)

accent   = unquote('var(--accent)')
working  = unquote('var(--working)')
emphasis = unquote('var(--emphasis)')
warning  = unquote('var(--warning)')

duration-press   = unquote('var(--duration-press)')
duration-quick   = unquote('var(--duration-quick)')
duration-reveal  = unquote('var(--duration-reveal)')
duration-subject = unquote('var(--duration-subject)')

ease-reveal = unquote('var(--ease-reveal)')
ease-settle = unquote('var(--ease-settle)')
ease-exit   = unquote('var(--ease-exit)')

stagger-step = unquote('var(--stagger-step)')

$h1-min = round(min-modular ** 4 * 1rem, 3)
$h1-max = round(max-modular ** 4 * 1rem, 3)

$h2-min = round(min-modular ** 3 * 1rem, 3)
$h2-max = round(max-modular ** 3 * 1rem, 3)

$h3-min = round(min-modular ** 2 * 1rem, 3)
$h3-max = round(max-modular ** 2 * 1rem, 3)

$h4-min = round(min-modular * 1rem, 3)
$h4-max = round(max-modular * 1rem, 3)

$h5-min= 1rem
$h5-max= 1rem

$h6-min= round(1rem / min-modular, 3)
$h6-max= round(1rem / max-modular, 3)
