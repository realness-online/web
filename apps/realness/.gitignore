# Generated files follow lib/output.js and lib/output.sh: a harness's artifacts/realness, or dist/
# on a host. A fresh clone is source only.
dist/


# Python bytecode from server/host/clients and server/host/guest; run as root it would
# leave root-owned files in the source tree.
__pycache__/
*.pyc

# The old names for dist/. Kept so a working tree that still has them does not
# have them committed by accident.
build/
runs/

node_modules/

# Firebase Functions local configuration and generated output
functions/.env*
!functions/.env.example
functions/.runtimeconfig.json
functions/coverage/
functions/service-account*.json
firebase-debug*.log
firestore-debug.log

# Browser generators write here; platform assets stay in public/.
src/app/prerender/toc.js
src/app/wasm/

# macOS
.DS_Store
tools/publish/renderer/.cache/

# Local HTTPS certificates from npm run certs; the key is private.
*.pem

# Web app: local env, generated public assets, and tool caches.
.env
.env.local
.env.*.local
service-account.json
scripts/service-account*
/coverage/
/public/**.worker.js
/public/**.worker.js.map
/public/**.wasm
/public/192.png
/public/512.png
/public/*.mov
*.wasm
/tracer/tracer
/tracer/pkg/
/tracer/target/
/tracer/Cargo.lock
/docs/generated/
/docs/keymap.md
/docs/keymap.schema.json
/docs/keymap.ref.json
.firebase/
.fallow/
.lighthouseci
.auto/
fallow-report.json
