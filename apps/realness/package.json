{
  "name": "brayness",
  "version": "2.10.7",
  "private": true,
  "type": "module",
  "description": "Realness: sign-on, private sync, hosted VMs, models, and publishing",
  "author": "Scott Fryxell <scott@realness.online>",
  "imports": {
    "#root/*": "./*"
  },
  "exports": {
    "./sign-on/flow": "./src/sign-on/browser/flow.js",
    "./sign-on/login": {
      "browser": null,
      "node": "./src/sign-on/node/login.js"
    },
    "./sign-on/host-pass": {
      "browser": null,
      "node": "./src/sign-on/node/host-pass.js"
    },
    "./harness/settings": {
      "browser": null,
      "node": "./src/harness/settings.js"
    },
    "./local/stack": {
      "browser": null,
      "node": "./src/command/local-stack.js"
    },
    "./local/monitor": {
      "browser": null,
      "node": "./src/command/local-monitor.js"
    },
    "./command": {
      "browser": null,
      "node": "./tools/cli/bin/brayness.js"
    },
    "./files/client": {
      "browser": null,
      "node": "./src/files/client.js"
    },
    "./publish/sources": "./src/publish/sources.js",
    "./publish/view": "./src/publish/view.js"
  },
  "bin": {
    "realness": "./tools/cli/bin/realness.js",
    "brayness": "./tools/cli/bin/brayness.js",
    "brayness-store": "./server/sync/bin/brayness-store.js",
    "brayness-publish": "./tools/publish/bin/publish.js",
    "webspace": "./tools/control/bin/webspace.js",
    "sync-service": "./server/sync/bin/sync-service.js"
  },
  "scripts": {
    "test": "npm run test:node && npm run test:renderer && npm run test:chat && npm run test:terminal && npm run test:frontend && npm run test:functions",
    "test:functions": "npm --prefix functions test",
    "check:functions": "npm --prefix functions run lint",
    "serve:functions": "npm --prefix functions run serve",
    "deploy:functions": "npm --prefix functions run deploy",
    "logs:functions": "npm --prefix functions run logs",
    "test:functions:watch": "npm --prefix functions run test:watch",
    "test:functions:coverage": "npm --prefix functions run test:coverage",
    "test:functions:gcs": "GCS_TEST_TOKEN=$(gcloud auth print-access-token) npm --prefix functions test -- tests/services/mirror-guards.gcs.spec.js",
    "test:functions:emulators": "firebase emulators:exec --only firestore,storage --project demo-realness-migration --config firebase.functions.test.json 'npm --prefix functions test -- tests/services/mirror-journal.emulator.spec.js tests/services/mirror-reconcile.emulator.spec.js'",
    "pre-commit:functions": "npm run check:functions && npm run test:functions",
    "traffic": "node tools/ops/hosting-traffic.js",
    "ads": "node tools/ops/ads-metrics.js",
    "repair": "node tools/ops/repair-people.js",
    "migration:report": "node tools/ops/report-html-migration.js",
    "test:chat": "node --test 'frontend/chat/test/*.test.js'",
    "build": "node tools/cli/bin/brayness.js frontend build --env production",
    "test:renderer": "cd tools/publish/renderer && node --test 'test/*.test.js'",
    "test:node": "node --test 'lib/can/test/*.test.js' 'lib/files/test/*.test.js' 'lib/harness/test/*.test.js' 'lib/sign-on/test/*.test.js' 'tools/cli/test/*.test.js' 'server/gate/test/*.test.js' 'tools/control/test/*.test.js' 'server/host/test/*.test.js' 'server/proxy/test/*.test.js' 'tools/publish/test/*.test.js' 'server/sync/test/*.test.js' 'lib/test/*.test.js' 'server/test/*.test.js' 'tools/test/*.test.js'",
    "deploy:sync": "bash server/sync/scripts/deploy.sh",
    "deploy:proxy": "bash server/proxy/scripts/deploy.sh",
    "serve:host": "node server/host/main.js serve",
    "start:sync": "node server/sync/bin/sync-service.js",
    "dev:sync": "node server/sync/bin/sync-service.js --dev",
    "start:proxy": "node server/proxy/bin/proxy-service.js",
    "store": "node server/sync/bin/brayness-store.js",
    "realness": "node tools/cli/bin/realness.js",
    "brayness": "node server/sync/bin/brayness.js",
    "publish": "node tools/publish/bin/publish.js",
    "webspace": "node tools/control/bin/webspace.js",
    "check:google": "node lib/can/test/google.check.js",
    "check:cli": "node ../../bin/no-mjs.js && node --test 'tools/cli/test/*.test.js'",
    "check:pi-exit": "node tools/control/test/pi-exit.check.js",
    "check:chat": "node tools/control/test/chat.check.js",
    "check:site": "node tools/control/test/site.check.js",
    "check:publish": "node tools/control/test/publish.check.js",
    "check:fresh-actor": "node --test --test-concurrency=1 tools/control/test/fresh-actor.check.js",
    "check:boundary": "node --test --test-concurrency=1 tools/control/test/actor-boundary.check.js",
    "check:host": "node --test --test-concurrency=1 tools/control/test/host.check.js",
    "check:actor-request": "node tools/control/test/actor-request.check.js",
    "check:chat-limit": "node tools/control/test/chat-limit.check.js",
    "secret": "bash tools/control/scripts/set-secret.sh",
    "dev:frontend": "cd frontend && node scripts/generate-toc.js && vp dev",
    "dev:frontend:workers": "cd frontend && node scripts/watch-workers.js",
    "check:frontend": "vp check frontend src/app src/terminal src/chat",
    "check:frontend:fix": "vp check --fix frontend src/app src/terminal src/chat",
    "type": "cd frontend && tsc --pretty",
    "certs": "cd frontend && ./scripts/generate-certs.sh",
    "check:interaction-css": "cd frontend && node scripts/check-interaction-css.js",
    "check:page-layout": "cd frontend && node scripts/check-page-layout.js",
    "build:prerender-ssr": "cd frontend && vp build -c vite.prerender.config.js",
    "build:prerender": "cd frontend && node scripts/prerender.js",
    "build:manifest": "cd frontend && node scripts/build-manifest.js",
    "build:toc": "cd frontend && node scripts/generate-toc.js",
    "build:icons": "cd frontend && node scripts/generate-icons.js",
    "build:workers": "cd frontend && WORKER_NAME=vector vp build -c workers.config.js && WORKER_NAME=compressor vp build -c workers.config.js && WORKER_NAME=tracer vp build -c workers.config.js",
    "build:wasm": "bash -c '. lib/output.sh && cd frontend && wasm-pack build tracer --target web --out-dir \"$OUT/wasm\"'",
    "og:candidates": "node tools/cli/bin/brayness.js frontend build --env production && cd frontend && CHROME_PATH=\"${CHROME_PATH:-/Applications/Brave Browser.app/Contents/MacOS/Brave Browser}\" node scripts/generate-og-candidates.js",
    "og:pick": "cd frontend && node scripts/pick-og.js",
    "poster": "cd frontend && node scripts/render-poster.js",
    "eval:chat-parts": "node frontend/scripts/chat-parts-eval.js",
    "prints:previews": "node tools/cli/bin/brayness.js frontend build --env production && cd frontend && CHROME_PATH=\"${CHROME_PATH:-/Applications/Brave Browser.app/Contents/MacOS/Brave Browser}\" node scripts/render-print-previews.js",
    "score": "cd frontend && CHROME_PATH=\"/Applications/Brave Browser.app/Contents/MacOS/Brave Browser\" lhci autorun --collect.url=https://realness.online/ --collect.numberOfRuns=5 --collect.settings.maxWaitForLoad=90000 --upload.target=temporary-public-storage && node scripts/print-lighthouse-metrics.js",
    "serve:frontend": "cd frontend && vp preview",
    "serve:frontend:https": "cd frontend && serve \"$(node ../src/settings/cli.js output frontend)\"",
    "preversion": "cd frontend && node scripts/check-release.js --unreleased",
    "version": "cd frontend && node scripts/promote-changelog.js && git add CHANGELOG.md",
    "postversion": "git push && git push --tags",
    "release:gh": "cd frontend && node scripts/check-release.js && node scripts/changelog-notes.js && gh release create v$npm_package_version \"$(node ../src/settings/cli.js output frontend)/build-manifest.json\" --title v$npm_package_version --target \"$(git rev-parse HEAD)\" --notes-file \"$(node ../src/settings/cli.js output frontend-notes)\"",
    "ship": "node tools/cli/bin/brayness.js frontend deploy --env production && npm run release:gh && npm run verify -- --release",
    "verify": "cd frontend && node scripts/verify-deploy.js",
    "verify:deploy:site": "cd frontend && node scripts/verify-deploy.js --from-site",
    "docs": "cd frontend && jsdoc -c jsdoc.json",
    "test:frontend": "cd frontend && vp test run --reporter=dot",
    "test:update": "cd frontend && vp test run -u --reporter=dot",
    "test:coverage": "cd frontend && vp test run --coverage --reporter=dot && node scripts/check-coverage.js",
    "fallow": "fallow",
    "fallow:report": "node frontend/scripts/quality-report.js fallow",
    "fallow:fix": "fallow fix",
    "test:risk": "npm run test:coverage && npm run fallow:report && npm run test:risk:report",
    "test:risk:report": "node frontend/scripts/quality-report.js risk",
    "test:coverage:summary": "node frontend/scripts/quality-report.js coverage",
    "test:watch": "cd frontend && vp test watch",
    "test:ui": "cd frontend && vp test --ui",
    "test:fail-fast": "cd frontend && vp test run --bail=1 --reporter=dot",
    "test:rules": "cd frontend && firebase emulators:exec --only storage --config firebase.test.json 'vp test run -c vitest.config.storage-rules.js'",
    "pre-commit": "npm run check:frontend:fix && npm run type && npm run test:frontend && npm run test:rules",
    "start:gate": "node server/gate/bin/gate-service.js",
    "dev:gate": "IDENTITY_PROJECT=realness-development PINS_BUCKET=realness-development.firebasestorage.app ORIGINS=https://realness.local,http://localhost:5173 GATE_HOST=127.0.0.1:18081 node server/gate/bin/gate-service.js",
    "deploy:gate": "bash server/gate/scripts/deploy.sh",
    "test:terminal": "node frontend/terminal/test/smoke.js && node frontend/terminal/test/smoke.js frontend/terminal/test/capture/pi.tui && node frontend/terminal/test/keys.js && node frontend/terminal/test/selection.js && node frontend/terminal/test/theme.js && node frontend/terminal/test/mouse.js && node frontend/terminal/test/reconnect.js && node frontend/terminal/test/open.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@comark/html": "0.4.0",
    "@realness.online/itemid": "file:frontend/packages/itemid",
    "@realness.online/store": "file:frontend/packages/store",
    "@realness.online/thoughts": "file:frontend/packages/thoughts",
    "@vueuse/core": "14.4.0",
    "ag-psd": "31.0.2",
    "comark": "0.4.0",
    "country-code-emoji": "2.3.0",
    "firebase": "12.19.0",
    "idb-keyval": "6.2.2",
    "libphonenumber-js": "1.12.41",
    "marked": "18.0.9",
    "marked-gfm-heading-id": "4.1.4",
    "mediabunny": "1.40.1",
    "mermaid": "12.0.0",
    "sharp": "0.35.4",
    "shiki": "4.4.3",
    "svgo": "4.1.0",
    "template-for-polyfill": "0.1.1",
    "three": "0.185.1",
    "tweakpane": "4.0.5",
    "vue": "3.5.43",
    "vue-router": "5.0.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "@lhci/cli": "0.15.1",
    "@testing-library/jest-dom": "6.9.1",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/eslint-plugin": "1.6.15",
    "@vitest/ui": "4.1.10",
    "@vue/test-utils": "2.5.1",
    "canvas": "3.2.3",
    "eslint-plugin-compat": "7.0.1",
    "fake-indexeddb": "6.2.5",
    "fallow": "3.10.0",
    "happy-dom": "20.14.5",
    "jsdoc": "4.0.5",
    "pako": "3.0.1",
    "stylus": "0.64.0",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.8",
    "vite-plugin-pwa": "1.2.0",
    "vite-plugin-wasm": "3.6.0",
    "vite-plus": "0.2.8"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.8",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10"
  },
  "browserslist": [
    ">0.5%",
    "not dead",
    "not IE 11",
    "not IE_Mob 11",
    "not op_mini all",
    "not ios_saf < 16"
  ],
  "allowScripts": {
    "canvas@3.2.3": true
  }
}
