{
  "name": "realness",
  "version": "3.0.0-g",
  "private": true,
  "type": "module",
  "description": "Realness: sign-on, private sync, hosted VMs, models, and publishing",
  "author": "Scott Fryxell <scott@realness.online>",
  "imports": {
    "#root/*": "./*"
  },
  "exports": {
    "./sign-on/flow": "./src/sign-on/browser/flow.js",
    "./sign-on/login": {
      "browser": null,
      "node": "./src/sign-on/node/login.js"
    },
    "./sign-on/halo-pass": {
      "browser": null,
      "node": "./src/sign-on/node/halo-pass.js"
    },
    "./harness/settings": {
      "browser": null,
      "node": "./src/harness/settings.js"
    },
    "./local/stack": {
      "browser": null,
      "node": "./src/command/local-stack.js"
    },
    "./local/monitor": {
      "browser": null,
      "node": "./src/command/local-monitor.js"
    },
    "./command": {
      "browser": null,
      "node": "./tools/cli/bin/realness.js"
    },
    "./files/client": {
      "browser": null,
      "node": "./src/files/client.js"
    },
    "./publish/sources": "./src/publish/sources.js",
    "./publish/view": "./src/publish/view.js"
  },
  "bin": {
    "realness": "./tools/cli/bin/realness.js",
    "realness-store": "./server/sync/bin/realness-store.js",
    "realness-publish": "./tools/publish/bin/publish.js",
    "sync-service": "./server/sync/bin/sync-service.js"
  },
  "scripts": {
    "test": "npm run check:quality && npm run test:frontend && npm run test:functions",
    "check:quality": "npm run check:backend && npm run type:backend && npm run fallow -- dead-code --fail-on-regression && npm run test:coverage:node",
    "test:functions": "npm --prefix functions test",
    "check:functions": "npm --prefix functions run lint",
    "serve:functions": "npm --prefix functions run serve",
    "deploy:functions": "npm --prefix functions run deploy",
    "logs:functions": "npm --prefix functions run logs",
    "test:functions:watch": "npm --prefix functions run test:watch",
    "test:functions:coverage": "npm --prefix functions run test:coverage",
    "pre-commit:functions": "npm run check:functions && npm run test:functions",
    "traffic": "node tools/ops/hosting-traffic.js",
    "ads": "node tools/ops/ads-metrics.js",
    "repair": "node tools/ops/repair-people.js",
    "build": "node tools/cli/bin/realness.js frontend build --env production",
    "test:node": "node --test 'tests/**/*.test.js'",
    "deploy:sync": "bash server/sync/scripts/deploy.sh",
    "deploy:proxy": "bash server/proxy/scripts/deploy.sh",
    "serve:halo": "node server/halo/main.js serve",
    "start:sync": "node server/sync/bin/sync-service.js",
    "dev:sync": "node server/sync/bin/sync-service.js --dev",
    "start:proxy": "node server/proxy/bin/proxy-service.js",
    "store": "node server/sync/bin/realness-store.js",
    "realness": "node tools/cli/bin/realness.js",
    "publish": "node tools/publish/bin/publish.js",
    "check:google": "node tests/can/google.check.js",
    "check:cli": "node ../../bin/no-mjs.js && node --test 'tests/command/*.test.js'",
    "check:pi-exit": "node tests/control/pi-exit.check.js",
    "check:capacity": "node tools/control/bin/capacity.js",
    "check:chat": "node tests/control/chat.check.js",
    "check:site": "node tests/control/site.check.js",
    "check:publish": "node tests/control/publish.check.js",
    "check:fresh-actor": "node --test --test-concurrency=1 tests/control/fresh-actor.check.js",
    "check:boundary": "node --test --test-concurrency=1 tests/control/actor-boundary.check.js",
    "check:halo": "node --test --test-concurrency=1 tests/control/halo.check.js",
    "check:actor-request": "node tests/control/actor-request.check.js",
    "check:chat-limit": "node tests/control/chat-limit.check.js",
    "secret": "bash tools/control/scripts/set-secret.sh",
    "dev:frontend": "cd frontend && node scripts/generate-toc.js && vp dev",
    "dev:frontend:workers": "cd frontend && node scripts/watch-workers.js",
    "check:frontend": "vp check frontend src/app",
    "check:frontend:fix": "vp check --fix frontend src/app",
    "type": "cd frontend && tsc --pretty",
    "type:backend": "tsc --project tsconfig.backend.json --pretty false",
    "check:backend": "vp check src tests",
    "certs": "cd frontend && ./scripts/generate-certs.sh",
    "check:interaction-css": "cd frontend && node scripts/check-interaction-css.js",
    "check:page-layout": "cd frontend && node scripts/check-page-layout.js",
    "build:prerender-ssr": "cd frontend && vp build -c vite.prerender.config.js",
    "build:prerender": "cd frontend && node scripts/prerender.js",
    "build:manifest": "cd frontend && node scripts/build-manifest.js",
    "build:toc": "cd frontend && node scripts/generate-toc.js",
    "build:icons": "cd frontend && node scripts/generate-icons.js",
    "build:workers": "cd frontend && WORKER_NAME=vector vp build -c workers.config.js && WORKER_NAME=compressor vp build -c workers.config.js && WORKER_NAME=tracer vp build -c workers.config.js",
    "build:ghostty": "sh frontend/scripts/build-ghostty-wasm.sh",
    "build:wasm": "bash -c '. lib/output.sh && cd frontend && wasm-pack build tracer --target web --out-dir \"$OUT/wasm\"'",
    "og:candidates": "node tools/cli/bin/realness.js frontend build --env production && cd frontend && CHROME_PATH=\"${CHROME_PATH:-/Applications/Brave Browser.app/Contents/MacOS/Brave Browser}\" node scripts/generate-og-candidates.js",
    "og:pick": "cd frontend && node scripts/pick-og.js",
    "poster": "cd frontend && node scripts/render-poster.js",
    "eval:chat-parts": "node frontend/scripts/chat-parts-eval.js",
    "prints:previews": "node tools/cli/bin/realness.js frontend build --env production && cd frontend && CHROME_PATH=\"${CHROME_PATH:-/Applications/Brave Browser.app/Contents/MacOS/Brave Browser}\" node scripts/render-print-previews.js",
    "score": "cd frontend && CHROME_PATH=\"/Applications/Brave Browser.app/Contents/MacOS/Brave Browser\" lhci autorun --collect.url=https://realness.online/ --collect.numberOfRuns=5 --collect.settings.maxWaitForLoad=90000 --upload.target=temporary-public-storage && node scripts/print-lighthouse-metrics.js",
    "serve:frontend": "cd frontend && vp preview",
    "serve:frontend:https": "cd frontend && serve \"$(node ../src/settings/cli.js output frontend)\"",
    "preversion": "cd frontend && node scripts/check-release.js --unreleased",
    "version": "cd frontend && node scripts/promote-changelog.js && cd .. && git add frontend/CHANGELOG.md package.json",
    "postversion": "git commit -m v$npm_package_version && git tag v$npm_package_version && git push -u origin HEAD && git push origin v$npm_package_version",
    "release:gh": "cd frontend && node scripts/check-release.js && node scripts/changelog-notes.js && gh release create v$npm_package_version $(case $npm_package_version in (*-*) echo --prerelease;; esac) \"$(node ../src/settings/cli.js output frontend)/build-manifest.json\" --title v$npm_package_version --target \"$(git rev-parse HEAD)\" --notes-file \"$(node ../src/settings/cli.js output frontend-notes)\"",
    "ship": "node tools/cli/bin/realness.js frontend deploy --env production && npm run release:gh && npm run verify -- --release",
    "verify": "cd frontend && node scripts/verify-deploy.js",
    "verify:deploy:site": "cd frontend && node scripts/verify-deploy.js --from-site",
    "docs": "cd frontend && jsdoc -c jsdoc.json",
    "test:frontend": "cd frontend && vp test run --reporter=dot",
    "test:update": "cd frontend && vp test run -u --reporter=dot",
    "test:coverage": "cd frontend && vp test run --coverage --reporter=dot && node scripts/check-coverage.js",
    "test:coverage:node": "node --test --experimental-test-coverage --test-coverage-include='src/**/*.js' --test-coverage-include='lib/**/*.js' --test-coverage-include='tools/**/*.js' --test-coverage-include='server/**/*.js' --test-coverage-include='themes/**/*.js' --test-coverage-exclude='src/app/**' --test-coverage-exclude='**/node_modules/**' --test-coverage-exclude='**/dist/**' --test-coverage-exclude='src/sign-on/browser/**' 'tests/**/*.test.js'",
    "test:coverage:all": "npm run test:coverage:node && npm run test:functions:coverage && npm run test:coverage",
    "fallow": "fallow",
    "fallow:report": "node frontend/scripts/quality-report.js fallow",
    "fallow:fix": "fallow fix",
    "test:risk": "npm run test:coverage && npm run fallow:report && npm run test:risk:report",
    "test:risk:report": "node frontend/scripts/quality-report.js risk",
    "test:coverage:summary": "node frontend/scripts/quality-report.js coverage",
    "test:watch": "cd frontend && vp test watch",
    "test:ui": "cd frontend && vp test --ui",
    "test:fail-fast": "cd frontend && vp test run --bail=1 --reporter=dot",
    "test:rules": "cd frontend && firebase emulators:exec --only storage --config firebase.test.json 'vp test run -c vitest.config.storage-rules.js'",
    "pre-commit": "npm run check:frontend:fix && npm run type && npm run test:frontend && npm run test:rules",
    "start:gate": "node server/gate/bin/gate-service.js",
    "dev:gate": "IDENTITY_PROJECT=realness-development PINS_BUCKET=realness-development.firebasestorage.app ORIGINS=https://realness.local,http://localhost:5173 GATE_HALO=127.0.0.1:18081 node server/gate/bin/gate-service.js",
    "deploy:gate": "bash server/gate/scripts/deploy.sh"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@comark/html": "0.4.0",
    "@realness.online/itemid": "file:frontend/packages/itemid",
    "@realness.online/store": "file:frontend/packages/store",
    "@realness.online/thoughts": "file:frontend/packages/thoughts",
    "@vueuse/core": "14.4.0",
    "ag-psd": "31.0.2",
    "comark": "0.4.0",
    "country-code-emoji": "2.3.0",
    "firebase": "12.19.0",
    "firebase-admin": "13.1.0",
    "idb-keyval": "6.2.2",
    "libphonenumber-js": "1.12.41",
    "marked": "18.0.9",
    "marked-gfm-heading-id": "4.1.4",
    "mediabunny": "1.40.1",
    "mermaid": "12.0.0",
    "pele": "1.6.0",
    "sharp": "0.35.4",
    "shiki": "4.4.3",
    "svgo": "4.1.0",
    "template-for-polyfill": "0.1.1",
    "three": "0.185.1",
    "tweakpane": "4.0.5",
    "vue": "3.5.43",
    "vue-router": "5.0.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "@lhci/cli": "0.15.1",
    "@testing-library/jest-dom": "6.9.1",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/eslint-plugin": "1.6.15",
    "@vitest/ui": "4.1.10",
    "@vue/test-utils": "2.5.1",
    "canvas": "3.2.3",
    "eslint-plugin-compat": "7.0.1",
    "fake-indexeddb": "6.2.5",
    "fallow": "3.10.0",
    "happy-dom": "20.14.5",
    "jsdoc": "4.0.5",
    "pako": "3.0.1",
    "stylus": "0.64.0",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.8",
    "vite-plugin-pwa": "1.2.0",
    "vite-plugin-wasm": "3.6.0",
    "vite-plus": "0.2.8"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.8",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10"
  },
  "browserslist": [
    ">0.5%",
    "not dead",
    "not IE 11",
    "not IE_Mob 11",
    "not op_mini all",
    "not ios_saf < 16"
  ],
  "allowScripts": {
    "canvas@3.2.3": true
  }
}
