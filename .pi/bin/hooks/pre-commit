#!/usr/bin/env bash
set -uo pipefail
root="$(git rev-parse --show-toplevel)"
cd "$root"
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE
logs="$root/artifacts/pre-commit"
rm -rf "$logs"
mkdir -p "$logs"
if { npm run check && npm test; } > "$logs/all.log" 2>&1; then exit 0; fi
grep -vE '^(npm notice|✔ |ℹ )' "$logs/all.log" | tail -80
printf '\nfull log: artifacts/pre-commit/all.log\n'
exit 1