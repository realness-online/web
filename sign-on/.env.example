# The public Firebase client config for the identity project. Every value
# below is safe to ship in a page; none is a secret.
VITE_API_KEY=
VITE_APP_ID=
VITE_AUTH_DOMAIN=
VITE_PROJECT_ID=
VITE_STORAGE_BUCKET=
VITE_MESSAGING_SENDER_ID=

# Optional: the browser terminal handoff. Set both to show the button that
# opens the host's /handoff page and posts a host pass into it.
# VITE_BRAYNESS_URL=http://localhost:18090
# VITE_BRAYNESS_SYNC_URL=https://your-sync-service.example
