{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": ["src/workers/*.js", "scripts/*.js"],
  "ignorePatterns": [
    "**/artifacts/**",
    "**/dist/**",
    "**/coverage/**",
    "**/src/wasm/**",
    "**/public/wasm/**",
    "**/docs/generated/**"
  ],
  "ignoreDependencies": ["stylus", "vue-eslint-parser"],
  "rules": {
    "unused-files": "warn",
    "unused-exports": "warn",
    "unused-types": "off",
    "unresolved-imports": "warn"
  },
  "overrides": [
    {
      "files": ["tests/**/*.js", "tests/**/*.spec.js", "**/tests/mocks/**"],
      "rules": {
        "unused-exports": "off",
        "unused-files": "off"
      }
    },
    {
      "files": [
        "src/components/icon.vue",
        "src/components/events/as-button.vue",
        "tests/mocks/html/**"
      ],
      "rules": {
        "unresolved-imports": "off"
      }
    }
  ],
  "duplicates": {
    "mode": "mild",
    "minTokens": 80,
    "minLines": 8
  },
  "health": {
    "ignore": ["**/tests/**", "**/src/wasm/**"],
    "maxCyclomatic": 20,
    "maxCognitive": 15
  },
  "ignoreExports": [
    {
      "file": "src/use/layer.js",
      "exports": ["*"]
    },
    {
      "file": "src/utils/opacity.js",
      "exports": ["*"]
    },
    {
      "file": "src/utils/color-converters.js",
      "exports": ["*"]
    },
    {
      "file": "src/utils/colors.js",
      "exports": ["*"]
    },
    {
      "file": "src/use/directory-processor.js",
      "exports": ["*"]
    },
    {
      "file": "src/use/optimize.js",
      "exports": ["*"]
    },
    {
      "file": "src/use/path.js",
      "exports": ["*"]
    },
    {
      "file": "src/use/pattern.js",
      "exports": ["*"]
    },
    {
      "file": "src/use/people.js",
      "exports": ["*"]
    },
    {
      "file": "src/use/poster.js",
      "exports": ["*"]
    },
    {
      "file": "src/use/statements.js",
      "exports": ["*"]
    },
    {
      "file": "src/use/sync-folder.js",
      "exports": ["*"]
    },
    {
      "file": "src/use/sync.js",
      "exports": ["*"]
    },
    {
      "file": "src/use/vectorize.js",
      "exports": ["*"]
    }
  ]
}
