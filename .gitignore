# Everything generated. A fresh clone is source only.
dist/

# The built browser terminal and chat (control/scripts/terminal-build.sh,
# control/scripts/chat-build.sh).
host/term/
host/chat/

# Python bytecode from host/clients and host/guest; run as root it would
# leave root-owned files in the source tree.
__pycache__/
*.pyc

# The old names for dist/. Kept so a working tree that still has them does not
# have them committed by accident.
build/
runs/

node_modules/

# macOS
.DS_Store
