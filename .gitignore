# Everything generated. A fresh clone is source only.
dist/

# The built browser terminal (control/scripts/terminal-build.sh).
orchestrator/term/

# Python bytecode. The orchestrator runs as root on a host and would otherwise
# leave root-owned files in the source tree.
__pycache__/
*.pyc

# The old names for dist/. Kept so a working tree that still has them does not
# have them committed by accident.
build/
runs/

# Dependencies. site/package.json names them; there is no lock yet, so
# `npm install` in site/ floats to current versions.
node_modules/

# A vendored mermaid bundle, 5.3 MB, provenance unrecorded (no version, no
# checksum, no fetch step in any build log). The orchestrator serves it at
# /mermaid.min.js from this path. Not committed while it is undecided: the
# builder injects `<script src="/mermaid.min.js">` by absolute path, so a
# published site only draws diagrams while a live host serves it, which
# contradicts the builder's own "needs no server of its own".
# Replaced by the npm package in the static example; deleted in x8
# (plans/brayness.md).
orchestrator/static/

# macOS
.DS_Store