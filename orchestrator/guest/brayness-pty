#!/usr/bin/env python3
"""Brayness session terminal - a pty on the guest end of the vsock channel.

socat runs one copy of this per connection (VSOCK-LISTEN:53,fork) with pipes on
stdin and stdout. The terminal is the other end: pty.fork() puts a shell on a
slave, and this relays bytes between the master and the pipes, so the shell sees
a real tty. Frames are JSON lines:

    in    {"op": "data", "data_b64": "..."}
          {"op": "resize", "cols": 100, "rows": 30}
    out   {"op": "data", "data_b64": "..."}
          {"op": "exit", "code": 0}

Base64 because a terminal carries binary; lines because the transport is a pipe
and the exec agent already proved that shape (f2). TIOCSWINSZ on the master is
what makes the guest see the client's window and sends SIGWINCH to the shell.

The shell dies with the connection: an EOF on stdin means the client is gone, so
there is no terminal to type into and no reason to leave a process behind. A
reconnectable terminal is not this node.

No authentication and no egress policy: the channel is a host-local unix socket.
h1/h2 in plans/brayness.md own identity and network.
"""
import base64
import fcntl
import json
import os
import pty
import select
import struct
import sys
import termios

SHELL = "/bin/bash"
# The one layout: the harness root, where a login lands and pi starts.
HOME_DIR = "/root/brayness"
# The browser page draws with libghostty-vt: 256 colors and truecolor.
TERM_ENV = {"TERM": "xterm-256color", "COLORTERM": "truecolor"}
DEFAULT_COLS = 80
DEFAULT_ROWS = 24


def emit(payload):
    sys.stdout.write(json.dumps(payload) + "\n")
    sys.stdout.flush()


def set_window(master, cols, rows):
    """The size the client wants. The kernel also signals SIGWINCH for us."""
    fcntl.ioctl(master, termios.TIOCSWINSZ, struct.pack("HHHH", rows, cols, 0, 0))


def main():
    pid, master = pty.fork()
    if pid == 0:
        # Child: the slave is stdin/stdout/stderr and the controlling terminal,
        # so a shell started here is interactive.
        os.environ.update(TERM_ENV)
        os.chdir(HOME_DIR if os.path.isdir(HOME_DIR) else "/root")
        os.execvp(SHELL, [SHELL])
        os._exit(127)

    set_window(master, DEFAULT_COLS, DEFAULT_ROWS)
    stdin = sys.stdin.fileno()
    pending = b""

    while True:
        readable, _, _ = select.select([master, stdin], [], [])
        if master in readable:
            try:
                data = os.read(master, 65536)
            except OSError:
                data = b""
            if not data:
                _, status = os.waitpid(pid, 0)
                emit({"op": "exit", "code": os.waitstatus_to_exitcode(status)})
                return
            emit({"op": "data", "data_b64": base64.b64encode(data).decode()})

        if stdin in readable:
            chunk = os.read(stdin, 65536)
            if not chunk:
                # The client closed: kill the shell so nothing is orphaned.
                try:
                    os.kill(pid, 15)
                except ProcessLookupError:
                    pass
                return
            pending += chunk
            while b"\n" in pending:
                line, _, pending = pending.partition(b"\n")
                if not line.strip():
                    continue
                try:
                    frame = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if frame.get("op") == "data":
                    os.write(master, base64.b64decode(frame.get("data_b64") or ""))
                elif frame.get("op") == "resize":
                    set_window(master, int(frame["cols"]), int(frame["rows"]))


main()
