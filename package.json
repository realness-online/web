{
  "name": "realness",
  "description": "Realness - a harness for your anxious digital brain",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./.pi/extensions"
    ],
    "skills": [
      "./.pi/skills"
    ],
    "prompts": [
      "./.pi/prompts"
    ],
    "themes": [
      "./.pi/agent/themes"
    ]
  },
  "realness": {
    "plans": "vault/Projects",
    "plansIgnore": [
      "Todo's.md",
      "site.md"
    ],
    "examples": ".pi/examples",
    "light": {
      "days": 14,
      "bytes": 2097152
    },
    "sessions": "vault/Sessions"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .pi/bin/hooks",
    "postinstall": "npm --prefix .pi ci && node .pi/bin/harness/install-pi.js && node .pi/bin/graphics/themes.js",
    "realness": "./.pi/bin/pi",
    "start": "./.pi/bin/pi",
    "local": "node .pi/bin/harness/local.js",
    "watch": "npm --prefix apps/realness run realness -- watch",
    "check": "node .pi/bin/harness/run-steps.js check",
    "test": "node .pi/bin/harness/run-steps.js test",
    "live": "node .pi/bin/harness/run-steps.js live",
    "check:soundness": "node ./.pi/bin/checks/soundness-check.js apps/realness work/blog work/decision-ontology work/kata-machine work/realness-flex work/seeq-models .pi/bin",
    "check:site": "node ./.pi/bin/checks/soundness-check.js --site",
    "pi:reinstall": "node .pi/bin/harness/install-pi.js",
    "pi:list": "./.pi/bin/pi list",
    "test:sessions": "./.pi/bin/checks/test-sessions.sh",
    "feeds": "./.pi/skills/vault/rebuild-feeds.sh",
    "commands": "node ./.pi/bin/harness/commands.js",
    "plans": "node ./.pi/bin/plans/plans.js",
    "vault:serve": "node ./.pi/bin/plans/plans-serve.js",
    "plans:serve": "npm run vault:serve",
    "make:animation": "node ./.pi/bin/graphics/make-animation.js",
    "make:posters": "node ./.pi/bin/graphics/make-posters.js",
    "gallery": "node ./.pi/bin/graphics/gallery.js",
    "prune:artifacts": "node ./.pi/bin/harness/artifacts-prune.js",
    "palette": "node ./.pi/bin/graphics/themes.js && node ./.pi/bin/graphics/palette-sync.js",
    "web-md:report": "node ./.pi/bin/web/web-md-report.js",
    "web-md:times": "node ./.pi/bin/web/web-md-report.js --times",
    "web-md:prune": "node ./.pi/bin/web/web-md-report.js --prune"
  },
  "license": "GPL-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "packageManager": "npm@11.14.1"
}
