{
  "name": "realness",
  "version": "1.0.1",
  "description": "Realness - a harness for your anxious digital brain",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./.pi/extensions"
    ],
    "skills": [
      "./.pi/skills"
    ],
    "prompts": [
      "./.pi/prompts"
    ],
    "themes": [
      "./.pi/agent/themes"
    ],
    "sessions": [
      "./sessions"
    ]
  },
  "brayness": {
    "plans": "vault/Projects",
    "plansIgnore": [
      "Todo's.md"
    ],
    "examples": ".pi/examples",
    "light": {
      "days": 14,
      "bytes": 2097152
    },
    "sessions": "vault/Sessions"
  },
  "scripts": {
    "postinstall": "npm --prefix .pi ci && node bin/install-pi.js",
    "realness": "./bin/pi",
    "brayness": "./bin/pi",
    "start": "./bin/pi",
    "local": "node bin/local.js",
    "test": "npm run test:harness && npm run check:harness && npm run test:product",
    "test:harness": "node --test 'bin/**/*.test.js' '.pi/extensions/**/*.test.js' '.pi/skills/**/*.test.js'",
    "check:harness": "npm run check:ext && npm run check:soundness:gate && npm run check:comments && npm run plan-shape && npm run check:palette",
    "test:product": "npm --prefix apps/realness test",
    "test:node": "npm --prefix apps/realness run test:node",
    "test:frontend": "npm --prefix apps/realness run test:frontend",
    "test:functions": "npm --prefix apps/realness run test:functions",
    "test:coverage": "node bin/coverage.js",
    "plan-shape": "node ./bin/plan-shape.js",
    "check:soundness": "node ./bin/soundness-check.js apps/realness work/blog work/decision-ontology work/kata-machine work/realness-flex work/seeq-models bin",
    "check:soundness:gate": "node ./bin/soundness-check.js apps/realness bin",
    "check:comments": "node ./bin/comment-check.js apps/realness apps/blog work/seeq-app work/decision-ontology work/realness-flex work/seeq-models work/site work/haight-ship work/nvim work/kata-machine bin skills .pi/skills .pi/extensions",
    "check:site": "node ./bin/soundness-check.js --site",
    "check:ext": "node ./bin/no-mjs.js",
    "check:skills": "node ./bin/check-skills.js",
    "pi:update": "node bin/install-pi.js",
    "pi:list": "./bin/pi list",
    "test:sessions": "./bin/test-sessions.sh",
    "feeds": "./.pi/skills/vault/rebuild-feeds.sh",
    "commands": "node ./bin/commands.js",
    "plans": "node ./bin/plans.js",
    "plans:serve": "node ./bin/plans-serve.js",
    "make:animation": "node ./bin/make-animation.js",
    "make:posters": "node ./bin/make-posters.js",
    "gallery": "node ./bin/gallery.js",
    "prune:artifacts": "node ./bin/artifacts-prune.js",
    "palette": "node ./bin/themes.js && node ./bin/palette-sync.js",
    "check:palette": "node ./bin/themes.js --check && node ./bin/palette-sync.js --check",
    "web-md:report": "node ./bin/web-md-report.js",
    "web-md:times": "node ./bin/web-md-report.js --times",
    "web-md:prune": "node ./bin/web-md-report.js --prune"
  },
  "license": "GPL-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "npm@11.14.1"
}
