#!/usr/bin/env bash
root="$(cd "$(dirname "$0")/.." && pwd)"
export PI_CODING_AGENT_DIR="$root/.pi/agent"
export TMPDIR="$root/artifacts/pi"
mkdir -p "$TMPDIR"
actor=0
if [[ "${1:-}" == "--actor" ]]; then actor=1; shift; fi
if [[ "$actor" == 1 || -r /etc/realness/actor || -r /usr/local/lib/realness/package.json ]]; then
  actor=1
fi
thought_minutes=13

# Checkout state is separate from an existing ~/.pi; neither is copied or deleted.

node_ok() {
  local ver major minor
  ver="$("$1" -v 2>/dev/null)" || return 1
  ver="${ver#v}"
  IFS=. read -r major minor _ <<< "$ver"
  (( major > 22 )) && return 0
  (( major == 22 && minor >= 19 )) && return 0
  return 1
}

best_node=""

consider_node() {
  [[ -n "$1" && -x "$1" ]] || return
  node_ok "$1" && best_node="$1"
}

consider_node "$(command -v node 2>/dev/null)"

if [[ -z "$best_node" ]]; then
  export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
  for nvm_sh in "$NVM_DIR/nvm.sh" "$(brew --prefix nvm 2>/dev/null)/nvm.sh"; do
    [[ -s "$nvm_sh" ]] || continue
    # shellcheck source=/dev/null
    . "$nvm_sh"
    consider_node "$(command -v node 2>/dev/null)"
    [[ -n "$best_node" ]] && break
  done
fi

if [[ -z "$best_node" ]]; then
  for candidate in $(ls -1d "$HOME"/.nvm/versions/node/v*/bin/node 2>/dev/null | sort -Vr); do
    consider_node "$candidate"
    [[ -n "$best_node" ]] && break
  done
fi

if [[ -z "$best_node" ]]; then
  echo "pi needs Node >= 22.19 (current: $(node -v 2>/dev/null || echo missing))" >&2
  echo "Fix: nvm install 24 && nvm use 24" >&2
  exit 1
fi

# The harness's own commands come first so a bare name resolves
# (`!realness-model-pass` in models.json). $root/bin goes last: an installed pi
# must win, or this wrapper skips itself and fetches pi from the registry.
export PATH="$(dirname "$best_node"):$PATH:$root/bin"

if [[ -z "${PI_CODING_AGENT_SESSION_DIR:-}" ]]; then
  PI_CODING_AGENT_SESSION_DIR="$("$best_node" "$root/bin/session-location.js" "$root")" || exit 1
  export PI_CODING_AGENT_SESSION_DIR
fi

if [[ "$actor" == 1 && $# == 0 && -n "$(find "$PI_CODING_AGENT_SESSION_DIR" -type f -mmin -"$thought_minutes" 2>/dev/null | head -1)" ]]; then
  set -- --continue
fi

# No update checks at startup: pi otherwise runs `npm view` for every package
# and asks pi.dev for its version on each launch. Update with `pi update`.
# PI_ONLINE=1 pi turns the startup network work back on (it also refreshes the
# model catalog). pi reads any non-empty PI_OFFLINE as on, so unset it here.
if [[ -n "${PI_ONLINE:-}" ]]; then unset PI_OFFLINE; else export PI_OFFLINE=1; fi

# A selected development fork affects only new launches. Otherwise a checkout
# runs its pinned package. Hosted actors retain their preinstalled PATH route.
# Both fork routes write compressed sessions and supply a read-only decoder.
if [[ -f "$PI_CODING_AGENT_DIR/state/fork-path" ]]; then
  IFS= read -r fork_binary < "$PI_CODING_AGENT_DIR/state/fork-path"
  [[ "$fork_binary" == /* ]] || fork_binary="$root/$fork_binary"
  if [[ ! -x "$fork_binary" || ! -x "$(dirname "$fork_binary")/pi-session-read" ]]; then
    echo "Selected fork is missing. Restore the previous route: node $root/bin/pi-fork.js rollback" >&2
    exit 1
  fi
  export PI_SESSION_READER="$(dirname "$fork_binary")/pi-session-read"
  export PI_SESSION_FORMAT=html.gz
  exec "$fork_binary" "$@"
fi

pinned_pi="$root/.pi/runtime/node_modules/.bin/pi"
pinned_reader="$root/.pi/runtime/node_modules/.bin/pi-session-read"
if [[ -x "$pinned_pi" && -x "$pinned_reader" ]]; then
  export PI_SESSION_READER="$pinned_reader"
  export PI_SESSION_FORMAT=html.gz
  exec "$pinned_pi" "$@"
fi

if [[ "$actor" == 1 ]]; then
  if pi_on_path="$(command -v pi 2>/dev/null)"; then
    if [[ "$pi_on_path" != "$root/bin/pi" ]]; then
      if reader_on_path="$(command -v pi-session-read 2>/dev/null)"; then
        export PI_SESSION_READER="$reader_on_path"
        export PI_SESSION_FORMAT=html.gz
      fi
      exec "$pi_on_path" "$@"
    fi
  fi
fi

echo "Pinned Pi is missing. Run npm install from $root." >&2
exit 1
